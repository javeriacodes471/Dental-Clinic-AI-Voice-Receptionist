    {
      "parameters": {
        "jsCode": "const busySlots = $input.first().json;\nconst requestedDate = $('Extract Tool Calls').first().json.args.date;\nconst toolCallId = $('Extract Tool Calls').first().json.toolCallId;\n\nconst checkDateObj = DateTime.fromISO(requestedDate, { zone: 'Asia/Karachi' });\nif (checkDateObj.weekday === 7) { // Luxon: 7 = Sunday\n  return [{\n    json: { toolCallId, result: \"We're closed on Sundays. Could you choose a day between Monday and Saturday?\" }\n  }];\n}\n\nconst clinicStart = 11;\nconst clinicEnd = 20;\nconst slotMins = 30;\n\nconst busy = (Array.isArray(busySlots) ? busySlots : []).map(b => ({\n  start: DateTime.fromISO(b.start),\n  end: DateTime.fromISO(b.end)\n}));\n\nconst freeSlots = [];\nlet cursor = DateTime.fromISO(requestedDate, { zone: 'Asia/Karachi' }).set({ hour: clinicStart, minute: 0, second: 0 });\nconst dayEnd = DateTime.fromISO(requestedDate, { zone: 'Asia/Karachi' }).set({ hour: clinicEnd, minute: 0, second: 0 });\n\nwhile (cursor < dayEnd) {\n  const slotEnd = cursor.plus({ minutes: slotMins });\n  const overlaps = busy.some(b => cursor < b.end && slotEnd > b.start);\n  if (!overlaps) {\n    freeSlots.push(cursor.setZone('Asia/Karachi').toFormat('h:mm a'));\n  }\n  cursor = slotEnd;\n}\n\nreturn [{\n  json: {\n    toolCallId,\n    result: freeSlots.length\n      ? `Available slots on ${requestedDate}: ${freeSlots.slice(0, 5).join(', ')}`\n      : `Sorry, no slots available on ${requestedDate}. Would you like a different date?`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
