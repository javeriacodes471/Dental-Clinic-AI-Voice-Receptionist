    {
      "parameters": {
        "jsCode": "const args = $json.args;\nconst toolCallId = $json.toolCallId;\n\nconst requestedHour = parseInt(args.time.split(':')[0]);\nconst clinicOpen = 11;\nconst clinicClose = 20;\n\nif (isNaN(requestedHour) || requestedHour < clinicOpen || requestedHour >= clinicClose) {\n  throw new Error(\"We're open 11 AM to 8 PM, Monday to Saturday. Could you pick a time within those hours?\");\n}\n\nconst requestedDateObj = new Date(args.date + 'T00:00:00+05:00');\nif (requestedDateObj.getDay() === 0) {\n  throw new Error(\"We're closed on Sundays. Could you choose a day between Monday and Saturday?\");\n}\n\nreturn [{ json: { toolCallId, args } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        784,
        -32
