    {
      "parameters": {
        "jsCode": "const events = $input.all().map(i => i.json);\nconst args = $('Extract Tool Calls').first().json.args;\nconst toolCallId = $('Extract Tool Calls').first().json.toolCallId;\n\nconst match = events.find(e => \n  e.summary && e.summary.toLowerCase().includes(args.name.toLowerCase())\n);\n\nif (!match) {\n  return [{\n    json: {\n      toolCallId,\n      result: `I couldn't find an appointment under that name on ${args.date}.`,\n      eventFound: false\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    toolCallId,\n    eventId: match.id,\n    eventFound: true\n  }\n}];\n"
