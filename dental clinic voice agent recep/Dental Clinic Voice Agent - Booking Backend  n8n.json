    {
      "parameters": {
        "jsCode": "const query = $json.args.question.toLowerCase();\nconst toolCallId = $json.toolCallId;\n\nconst faqs = {\n  hours: \"We're open Monday to Saturday, 9 AM to 6 PM.\",\n  insurance: \"We accept most major insurance providers. Please bring your card.\",\n  services: \"We offer cleanings, fillings, root canals, and cosmetic dentistry.\",\n  location: \"We're located at [your demo clinic address].\"\n};\n\nlet answer = \"I don't have that information right now, but our staff can help you when you visit.\";\nfor (const key in faqs) {\n  if (query.includes(key)) { answer = faqs[key]; break; }\n}\n\nreturn [{ json: { toolCallId, result: answer } }];"
      },
