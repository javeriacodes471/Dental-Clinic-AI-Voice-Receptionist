      "id": "3116e4cd-d115-47f0-aeac-538d9c4a72a4",
      "name": "validate timing",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const args = $json.args;\nconst toolCallId = $json.toolCallId;\nconst rawDate = args.date;\n\nfunction parseDate(input) {\n  if (!input) return null;\n  input = String(input).trim();\n\n  if (/^\\d{4}-\\d{2}-\\d{2}$/.test(input)) return input;\n\n  let m = input.match(/^(\\d{1,2})[\\/\\-](\\d{1,2})[\\/\\-](\\d{4})$/);\n  if (m) {\n    const day = m[1].padStart(2, '0');\n    const month = m[2].padStart(2, '0');\n    return `${m[3]}-${month}-${day}`;\n  }\n\n  const parsed = new Date(input);\n  if (!isNaN(parsed.getTime())) {\n    const y = parsed.getFullYear();\n    const mo = String(parsed.getMonth() + 1).padStart(2, '0');\n    const d = String(parsed.getDate()).padStart(2, '0');\n    return `${y}-${mo}-${d}`;\n  }\n  return null;\n}\n\nconst cleanDate = parseDate(rawDate);\n\nif (!cleanDate) {\n  throw new Error(\"I didn't catch the date clearly. Could you say it like 'August 16th'?\");\n}\n\nreturn [{ json: { toolCallId, args: { ...args, date: cleanDate } } }];"
      },
